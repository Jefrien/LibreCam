{
  "name": "@librecam/server",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "private": true,
  "dependencies": {
    "@librecam/pppp": "workspace:*",
    "fastify": "^5.12.8",
    "ws": "^8.22.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "probe": "node --env-file-if-exists=../../.env --import tsx src/probe.ts",
    "test": "node --import tsx --test src/*.test.ts"
  }
}
